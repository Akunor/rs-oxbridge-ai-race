# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
# .env.local is git-ignored. Never commit real keys.

# --- Gemini AI ---
# From https://aistudio.google.com/apikey. Server-only. (required, SECRET, never commit or expose to the browser)
GEMINI_API_KEY=
# Optional model override. (optional)
GEMINI_MODEL=gemini-flash-latest

# --- Internet-Native Payments (x402 V2, Solana devnet) ---
# Your Solana devnet wallet address. Payments to your paid API arrive here. (required)
PAY_TO_ADDRESS=
# CAIP-2 id. Only Solana devnet is allowed by this template. (optional)
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
# Free public test facilitator: verifies + settles devnet payments and pays the SOL fees. (optional)
X402_FACILITATOR_URL=https://x402.org/facilitator
# DEVNET-ONLY throwaway key for the paying side (buyer). Base58 or solana-keygen JSON array. Never commit. (optional, SECRET, never commit or expose to the browser)
AGENT_PRIVATE_KEY=
# Optional devnet RPC used when building payments. (optional)
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=20933d58-7daa-4b04-af3b-32f24c16409e

# --- AI Race adapter ---
# From your team page on Agent Studio. Only the race verifier sends it. (required, SECRET, never commit or expose to the browser)
AGENT_STUDIO_VERIFIER_TOKEN=
# Name shown in the health response. (optional)
AGENT_STUDIO_APP_NAME=PayeeGuard
# For the Memory layer on serverless hosting (Vercel): keeps conversation history between requests. Free Upstash Redis database; Vercel's Upstash integration sets KV_REST_API_URL instead, which also works. (optional)
UPSTASH_REDIS_REST_URL=
# The REST token for that database (or KV_REST_API_TOKEN from Vercel's integration). (optional, SECRET, never commit or expose to the browser)
UPSTASH_REDIS_REST_TOKEN=

# --- Spending Controls ---
# Total the buyer may spend before the server restarts. Default 1.00. (optional)
AGENT_BUDGET_USD=1.00
# Largest single payment allowed. Default 0.10. (optional)
MAX_PAYMENT_USD=0.10

# --- Paid API Example ---
# Price per request in (devnet) USDC. Default 0.01. (optional)
PAID_API_PRICE_USD=0.01

# --- Pay.sh ---
# Your deployed https:// address, used in the Pay.sh catalog listing. Leave empty while you build locally. (optional)
PAYSH_SERVICE_URL=

# --- Wallet Connection ---
# Devnet RPC the browser uses to build wallet payments. NEXT_PUBLIC_ values are visible to everyone, so never put a key here (optional)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# --- PayeeGuard ---
# Your Challenge ID (team page), for the on-chain bonus challenges on /setup.
CHALLENGE_ID=
# The demo coffee shop's wallet address (make one on /setup). PAY_TO_ADDRESS above can be the same.
MERCHANT_ADDRESS=
# Verified B2B vendor (Mekong Logistics) — must be its own wallet, not MERCHANT_ADDRESS.
VENDOR_ADDRESS=
# Optional display name override for the invoice vendor. (optional)
VENDOR_NAME=
# The "new shop" wallet: your Phantom wallet address, so you can sign its verification.
NEW_MERCHANT_ADDRESS=
# Optional: Claude instead of Gemini (if both are set, Claude is used unless AI_PROVIDER=gemini).
ANTHROPIC_API_KEY=
# Optional: secret for signed verification tokens (any long random text).
GUARD_SECRET=

# --- Optional Jev System-1 (soft risk only) ---
# Additive soft scores for message/email social signals. Never overrides hard BLOCK (lookalike / invalid address).
# If unset or the call fails, PayeeGuard continues on rules + existing AI.
JEV_API_KEY=
# Hosted System-1 endpoint (trailing slash optional). (optional)
JEV_BASE_URL=https://jev-api.com/v1/systemone
# Model id. (optional)
JEV_MODEL=jev-latest
